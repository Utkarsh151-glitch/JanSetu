{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JanSetu bundled local catalog",
  "type": "object",
  "required": ["version", "categories", "websites"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "categories": {"type": "array", "items": {"type": "object", "required": ["id", "title", "titleHi", "symbol"]}},
    "websites": {"type": "array", "items": {"$ref": "#/$defs/website"}},
    "services": {"type": "array"},
    "guides": {"type": "array"}
  },
  "$defs": {
    "https": {"type": "string", "pattern": "^https://"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "website": {
      "type": "object",
      "required": ["id", "title", "url", "description", "organization", "level", "categories", "keywords", "sourceUrl", "sourceType", "verificationStatus", "verifiedOn"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"$ref": "#/$defs/https"},
        "sourceUrl": {"$ref": "#/$defs/https"},
        "verificationStatus": {"enum": ["verified", "directory_listed"]},
        "categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "state": {"type": ["string", "null"]},
        "district": {"type": ["string", "null"]},
        "sourceRetrievedOn": {"$ref": "#/$defs/date"},
        "sourceEvidence": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["sourceId", "sourcePage", "originalUrl", "retrievedAt"],
          "properties": {"sourcePage": {"$ref": "#/$defs/https"}, "originalUrl": {"$ref": "#/$defs/https"}}
        }}
      },
      "allOf": [{
        "if": {"properties": {"verificationStatus": {"const": "directory_listed"}}},
        "then": {
          "required": ["sourceId", "sourceRetrievedOn", "sourceEvidence", "healthStatus", "healthCheckedAt", "publicationScope"],
          "properties": {"sourceId": {"const": "igod"}, "healthStatus": {"const": "RESPONDING"}, "publicationScope": {"const": "local_development"}, "browserSupport": {"const": "external"}}
        },
        "else": {"properties": {"verifiedOn": {"$ref": "#/$defs/date"}}}
      }]
    }
  }
}
